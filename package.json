{
  "name": "crm-premium-google",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "node server/index.js",
    "start": "node server/index.js",
    "migrate:sqlite:mysql": "node server/migrate-sqlite-to-mysql.js",
    "test:integration": "node --test server/zapeIntegration.test.js",
    "test": "node --test \"server/**/*.test.js\" scripts/*.test.mjs",
    "test:security": "node --test server/security.test.js",
    "test:release": "node --test scripts/create-release.test.mjs",
    "release:check": "node scripts/create-release.mjs --check",
    "release": "node scripts/create-release.mjs",
    "test:backup": "node --test server/backup/*.test.js server/migrations/20260707_06_backup_integrity.test.js",
    "test:backup:restore": "node scripts/test-backup-restore.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:audit": "npm audit --audit-level=high",
    "ci": "npm run security:scan && npm run security:audit && npm test && npm run build && npm run test:e2e:list && npm run release:check",
    "test:phase4": "node --test server/mysqlReliability.test.js server/jobQueue.test.js server/jobArtifacts.test.js server/leadExport.test.js server/httpCompression.test.js server/migrations/20260707_08_async_jobs.test.js server/phase4ReliabilityWiring.test.js",
    "test:mysql": "RUN_MYSQL_INTEGRATION=1 node --test server/integration/http.mysql.test.js",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:load": "node scripts/load-test.mjs",
    "test:phase6": "node --test server/domains/leads/leadMapper.test.js server/http/staticAssets.test.js server/phase6ArchitectureWiring.test.js",
    "env:normalize": "node scripts/normalize-env.mjs",
    "clean:local": "powershell -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1",
    "test:perf-observability": "node --test server/performanceMetrics.test.js",
    "perf:report": "node scripts/performance-report.mjs",
    "commercial-profile:backfill": "node scripts/backfill-commercial-profile.mjs",
    "commercial-profile:verify": "node scripts/backfill-commercial-profile.mjs --verify-only",
    "search-index:backfill": "node scripts/backfill-search-index.mjs",
    "search-index:verify": "node scripts/backfill-search-index.mjs --verify-only",
    "start:api": "PROCESS_ROLE=api node server/index.js",
    "start:worker": "PROCESS_ROLE=worker node server/index.js",
    "test:phase6-performance": "node --test server/runtimeRole.test.js server/phase6WorkerIsolation.test.js server/jobQueue.test.js",
    "test:phase7-performance": "node --test server/phase7ImportBatch.test.js server/operationalIntegrityWiring.test.js server/phase6ArchitectureWiring.test.js",
    "datetime:backfill": "node scripts/backfill-datetime-columns.mjs",
    "datetime:verify": "node scripts/backfill-datetime-columns.mjs --verify-only",
    "test:phase8-performance": "node --test server/dateColumns.test.js server/migrations/20260724_10_parallel_datetime_columns.test.js server/phase8DatetimeMigration.test.js",
    "mysql:explain": "node scripts/mysql-explain-analyze.mjs",
    "mysql:explain:plan": "node scripts/mysql-explain-analyze.mjs --explain-only",
    "test:phase9-performance": "node --test scripts/mysql-explain-core.test.mjs server/phase9IndexReadiness.test.js",
    "test:phase10-performance": "node --test server/runtimeCache.test.js server/phase10SmartCache.test.js server/phase3DashboardAggregation.test.js server/phase6ArchitectureWiring.test.js",
    "test:phase11-performance": "node --test server/phase11FrontendPerformance.test.js server/phase10SmartCache.test.js server/phase6ArchitectureWiring.test.js",
    "mysql:hardening": "node scripts/mysql-hardening-audit.mjs",
    "test:phase12-performance": "node --test scripts/mysql-hardening-core.test.mjs server/phase12MysqlHardening.test.js server/mysqlReliability.test.js server/phase9IndexReadiness.test.js",
    "test:phase13-performance": "node --test scripts/load-test-core.test.mjs server/phase13LoadTest.test.js",
    "test:load:smoke": "RUN_LOAD_TEST=1 LOAD_TEST_PROFILE=smoke node scripts/load-test.mjs",
    "test:load:full": "RUN_LOAD_TEST=1 LOAD_TEST_PROFILE=full node scripts/load-test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "mysql2": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "fflate": "^0.8.3",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
