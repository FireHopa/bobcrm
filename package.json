{
  "name": "crm-premium-google",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "node server/index.js",
    "start": "node server/index.js",
    "migrate:sqlite:mysql": "node server/migrate-sqlite-to-mysql.js",
    "test:integration": "node --test server/zapeIntegration.test.js",
    "test": "node --test \"server/**/*.test.js\" scripts/*.test.mjs",
    "test:security": "node --test server/security.test.js",
    "test:release": "node --test scripts/create-release.test.mjs",
    "release:check": "node scripts/create-release.mjs --check",
    "release": "node scripts/create-release.mjs",
    "test:backup": "node --test server/backup/*.test.js server/migrations/20260707_06_backup_integrity.test.js",
    "test:backup:restore": "node scripts/test-backup-restore.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:audit": "npm audit --audit-level=high",
    "ci": "npm run security:scan && npm run security:audit && npm test && npm run build && npm run test:e2e:list && npm run release:check",
    "test:phase4": "node --test server/mysqlReliability.test.js server/jobQueue.test.js server/jobArtifacts.test.js server/leadExport.test.js server/httpCompression.test.js server/migrations/20260707_08_async_jobs.test.js server/phase4ReliabilityWiring.test.js",
    "test:mysql": "RUN_MYSQL_INTEGRATION=1 node --test server/integration/http.mysql.test.js",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:load": "node scripts/load-test.mjs",
    "test:phase6": "node --test server/domains/leads/leadMapper.test.js server/http/staticAssets.test.js server/phase6ArchitectureWiring.test.js",
    "env:normalize": "node scripts/normalize-env.mjs",
    "clean:local": "powershell -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "mysql2": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "fflate": "^0.8.3",
    "typescript": "^5.6.3",
    "vite": "^8.1.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
