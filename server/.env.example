# BobCRM API / MySQL
NODE_ENV=production
# combined mantém compatibilidade ao executar node server/index.js diretamente. O PM2 usa api/worker separadamente.
PROCESS_ROLE=combined
SERVER_PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bobcrm
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=crm_casa_ads
MYSQL_CONNECTION_LIMIT=10
# Fase 6: pools independentes. Defaults preservam 10 conexões totais no PM2 (8 API + 2 worker).
MYSQL_API_CONNECTION_LIMIT=8
MYSQL_WORKER_CONNECTION_LIMIT=2
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_RETRY_ATTEMPTS=4
MYSQL_RETRY_BASE_DELAY_MS=150
MYSQL_RETRY_MAX_DELAY_MS=3000
MYSQL_TRANSACTION_RETRY_ATTEMPTS=3
LEAD_IDENTITY_LOCK_TIMEOUT_SECONDS=10

# Paginação e busca
DEFAULT_LEADS_PAGE_LIMIT=150
MAX_LEADS_PAGE_LIMIT=1000
MAX_LEADS_OFFSET=10000
SEARCH_INDEX_REBUILD_BATCH_SIZE=750
SEARCH_INDEX_REBUILD_ON_START=0
# Fase 7: quantidade de leads persistidos por transação durante importações (100-1000).
IMPORT_DB_BATCH_SIZE=500
LEAD_SUMMARY_CACHE_MS=15000
# Fase 10: caches curtos de metadados e opções agregadas.
METADATA_CACHE_MS=30000
FILTER_OPTIONS_CACHE_MS=15000

# Fase 2: inteligência comercial materializada
COMMERCIAL_PROFILE_READINESS_CHECK_MS=30000
COMMERCIAL_PROFILE_BACKFILL_BATCH_SIZE=500
COMMERCIAL_PROFILE_BACKFILL_PAUSE_MS=25

# Fase 8: colunas DATETIME(3) paralelas. Filtros só mudam após datetime:verify retornar pending=0.
DATETIME_COLUMNS_READINESS_CHECK_MS=30000
DATETIME_BACKFILL_BATCH_SIZE=500
DATETIME_BACKFILL_PAUSE_MS=25

# Jobs / artifacts
JOB_ARTIFACT_DIR=/var/lib/bobcrm/jobs
JOB_WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=1500
JOB_HEARTBEAT_INTERVAL_MS=10000
JOB_STALE_AFTER_MS=120000
JOB_CLEANUP_INTERVAL_MS=900000

# HTTP / shutdown
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
MAX_BODY_BYTES=16777216

# Sessão / segurança
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=crm_casa_ads_session
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAME_SITE=Lax
TRUST_PROXY=0
TRUST_PROXY_ADDRESSES=
TRUST_PROXY_HOPS=1
CORS_ORIGIN=

# Rate limit
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_IP=20
LOGIN_RATE_LIMIT_MAX_EMAIL=10
INTEGRATION_RATE_LIMIT_WINDOW_MS=60000
INTEGRATION_RATE_LIMIT_MAX=300
RATE_LIMIT_CLEANUP_INTERVAL_MS=600000

# Integrações
ZAPE_INTEGRATION_KEY=change_me
INTEGRATION_MAX_BODY_BYTES=524288

# Administrador inicial. Use somente em banco sem usuários.
CRM_ADMIN_NAME=Administrador
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=change_this_strong_password

# Fase 12: auditoria somente leitura de hardening MySQL.
MYSQL_HARDENING_SAMPLE_SECONDS=5
MYSQL_HARDENING_MAX_DIGESTS=20
